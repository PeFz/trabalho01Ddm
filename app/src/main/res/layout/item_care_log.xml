<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="top"
    android:orientation="horizontal">

    <!-- Coluna da Linha do Tempo (Ícone circular + linha vertical) -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogTimelineDot"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_pill_sage"
            android:gravity="center"
            android:text="💧"
            android:textSize="12sp" />

        <View
            android:layout_width="2dp"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="@color/divider_color" />
    </LinearLayout>

    <!-- Card do Evento no Diário de Cuidados -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_card_white"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLogDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Há 6 dias • 24 Out"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_warm"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Por Você"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLogDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rega completa realizada (400ml)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

